rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Rules flexíveis para uso em sala de aula / protótipo.
    // Qualquer usuário autenticado (ex.: anônimo) pode ler e escrever.

    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
